# Environment variables for the server application
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/imageStack

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=image-stack:

JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800

APP_DOMAIN=http://localhost:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_SEND_FROM="Media Hub <no-reply@example.com>"
