# Environment variables for the server application
NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/imageStack

ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# 支持 B/MB/GB 单位，图片文件默认 10MB
ASSETE_SIZE=10MB
# 视频文件大小上限，默认 1GB，不限制视频时长
VIDEO_ASSET_SIZE=1GB
FILE_ASSET_SIZE=1GB

# Storage: LOCAL_FS or RUST_FS; restart after changes. See ../../STORAGE.md
# Keep the original root for historical local files; optional for RustFS-only installs.
STORAGE_DRIVER=LOCAL_FS
STORAGE_ROOT=/var/lib/image-stack/files
STORAGE_MAX_FILE_BYTES=1073741824
# Object storage uses an S3 API endpoint, not the console; create a private bucket first.
# Example: http://127.0.0.1:9002 (mapped to RustFS API port 9000 to avoid ASR conflicts).
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
STORAGE_REQUEST_TIMEOUT_MS=60000
STORAGE_TOTAL_BYTES=

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=image-stack:

RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_QUEUE_PREFIX=image-stack
RABBITMQ_CONNECT_TIMEOUT_MS=10000
RABBITMQ_PUBLISH_TIMEOUT_MS=5000

MEDIA_PROCESSING_CONCURRENCY=2
MEDIA_PROCESSING_ATTEMPTS=3
MEDIA_PROCESSING_LEASE_MS=120000
MEDIA_PROCESSING_BACKOFF_MS=1000
MEDIA_PROCESSING_RECONCILE_INTERVAL_MS=30000
MEDIA_PROCESSING_RECONCILE_BATCH_SIZE=100
MEDIA_PROCESSING_READ_TIMEOUT_MS=30000
MEDIA_EXIF_DEFAULT_OFFSET=+00:00
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_VIDEO_PROBE_TIMEOUT_MS=30000
MEDIA_VIDEO_PROCESSING_TIMEOUT_MS=600000
OPENAI_API_MODULE=
OPENAI_API_VISION_MODULE=
OPENAI_API_IMAGE_MODULE=
OPENAI_EMBEDDING=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_AUTO_INDEX=true
AI_REQUEST_TIMEOUT_MS=60000
AI_INDEX_CONCURRENCY=1
ASR_BASE_URL=http://127.0.0.1:9000
ASR_REQUEST_TIMEOUT_MS=1800000
VIDEO_SUMMARY_AUTO=true
VIDEO_SUMMARY_MODEL=
VIDEO_SUMMARY_CONCURRENCY=1
VIDEO_SUMMARY_REQUEST_TIMEOUT_MS=120000
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=image-stack:

JWT_SECRET=
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=604800

APP_DOMAIN=http://localhost:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_SEND_FROM="Media Hub <no-reply@example.com>"
